<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log In | Pet Paradise Keepers</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/ui.js" defer></script>
</head>
<body>
  <%- include('partials/header') %>

  <main class="auth-shell" id="main-content">
    <section class="auth-story" aria-labelledby="auth-story-title">
      <p class="eyebrow">A PLACE FOR PET PEOPLE</p>
      <h2 id="auth-story-title">Good care starts with the little details.</h2>
      <p>From a favorite photo to an important care note, keep the things that matter together.</p>

      <ul class="auth-benefits">
        <li>
          <span class="icon-badge"><%- include('partials/icon', { name: 'paw' }) %></span>
          <div>
            <strong>Every pet, their own little space</strong>
            <p>Photos, medical history, and details you can come back to.</p>
          </div>
        </li>
        <li>
          <span class="icon-badge"><%- include('partials/icon', { name: 'heart' }) %></span>
          <div>
            <strong>Care with a personal touch</strong>
            <p>A sitter profile for your story, experience, and hourly rate.</p>
          </div>
        </li>
      </ul>

      <footer><small>Made for pets and the people who love them.</small></footer>
    </section>

    <section class="auth-card" aria-labelledby="login-title">
      <p class="eyebrow">WELCOME HOME</p>
      <h1 id="login-title">Welcome back.</h1>
      <p class="muted">Log in to your pet dashboard.</p>

      <% if (errorMessage) { %>
        <div class="alert" id="login-error" role="alert"><%= errorMessage %></div>
      <% } %>

      <form class="auth-form" action="/login" method="post"<% if (errorMessage) { %> aria-describedby="login-error"<% } %>>
        <div class="form-group">
          <label for="username">Username or email</label>
          <input type="text" id="username" name="username" required autocomplete="username" value="<%= typeof username !== 'undefined' ? username : '' %>" placeholder="Enter your username or email">
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="password-field">
            <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="Enter your password">
            <button type="button" id="togglePassword" class="password-toggle" data-password-toggle="password" aria-controls="password" aria-pressed="false" aria-label="Show password">Show</button>
          </div>
        </div>

        <button type="submit" class="button button-primary">Log in <%- include('partials/icon', { name: 'arrow-right' }) %></button>
      </form>

      <p class="auth-switch">New around here? <a href="/register">Create an account</a></p>
      <a href="/" class="button button-ghost"><%- include('partials/icon', { name: 'arrow-left' }) %> Back to home</a>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
