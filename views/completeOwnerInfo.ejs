<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#244a3a">
  <title>Welcome home · Pet Paradise Keepers</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/ui.js" defer></script>
</head>
<body>
  <%- include('partials/header') %>
  <main id="main-content" class="page-shell page-shell-narrow">
    <div class="page-header">
      <div><p class="eyebrow">Welcome to the family</p><h1>Let's meet your little companion.</h1><p class="muted">Add a photo and your first pet. A few small details, a lot of love.</p></div>
    </div>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert" role="alert"><%= errorMessage %></div>
    <% } %>
    <form class="form-card" action="/submitOwnerInfo" method="post" enctype="multipart/form-data">
      <section class="form-section" aria-labelledby="photoHeading">
        <div class="section-heading"><div><p class="eyebrow">A friendly face</p><h2 id="photoHeading">Your profile photo</h2></div><span class="badge">Optional</span></div>
        <div class="upload-field">
          <div class="photo-preview">
            <% if (user.profilePhoto) { %>
              <img src="<%= '/' + user.profilePhoto.replace(/^public\//, '').replace(/^\/+/, '') %>" alt="Your current profile photo" id="onboarding-owner-photo" data-image-preview>
            <% } else { %>
              <img alt="Your selected profile photo" id="onboarding-owner-photo" data-image-preview hidden>
              <span class="photo-placeholder" aria-hidden="true"><%- include('partials/icon', { name: 'user' }) %></span>
            <% } %>
          </div>
          <div class="form-group">
            <label for="ownerPhoto">Your photo</label>
            <input type="file" id="ownerPhoto" name="ownerPhoto" accept="image/jpeg,image/png,image/gif,image/webp" data-image-input="onboarding-owner-photo" aria-describedby="ownerPhotoHelp">
            <p id="ownerPhotoHelp" class="field-help">JPG, PNG, GIF, or WebP. Up to 5 MB.</p>
          </div>
        </div>
      </section>
      <section class="form-section" aria-labelledby="petHeading">
        <div class="section-heading"><div><p class="eyebrow">Small paws, big personality</p><h2 id="petHeading">Your first pet</h2></div><span class="badge">Optional</span></div>
        <p class="field-help">Add both a name and type to create a pet profile. You can add more pets later.</p>
        <div class="form-grid">
          <div class="form-group">
            <label for="petName">Pet's name</label>
            <input type="text" id="petName" name="petName" maxlength="100" placeholder="e.g. Mochi" value="<%= typeof values !== 'undefined' ? values.petName || '' : '' %>">
          </div>
          <div class="form-group">
            <label for="petType">Pet type</label>
            <input type="text" id="petType" name="petType" maxlength="100" placeholder="e.g. Cat, dog, or rabbit" value="<%= typeof values !== 'undefined' ? values.petType || '' : '' %>">
          </div>
          <div class="form-group form-group-full">
            <label for="petMedicalHistory">Medical history &amp; care notes</label>
            <textarea id="petMedicalHistory" name="petMedicalHistory" rows="4" maxlength="5000" placeholder="Medication, allergies, or anything helpful to know"><%= typeof values !== 'undefined' ? values.petMedicalHistory || '' : '' %></textarea>
          </div>
        </div>
        <div class="upload-field">
          <div class="photo-preview">
            <img alt="Your selected pet photo" id="first-pet-photo" data-image-preview hidden>
            <span class="photo-placeholder" aria-hidden="true"><%- include('partials/icon', { name: 'paw' }) %></span>
          </div>
          <div class="form-group">
            <label for="petPhoto">Pet photo</label>
            <input type="file" id="petPhoto" name="petPhoto" accept="image/jpeg,image/png,image/gif,image/webp" data-image-input="first-pet-photo" aria-describedby="petPhotoHelp">
            <p id="petPhotoHelp" class="field-help">JPG, PNG, GIF, or WebP. Up to 5 MB.</p>
          </div>
        </div>
      </section>
      <div class="form-actions">
        <a href="/dashboard" class="button button-ghost">Skip for now</a>
        <button type="submit" class="button button-primary">Save &amp; continue <%- include('partials/icon', { name: 'arrow-right' }) %></button>
      </div>
    </form>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
