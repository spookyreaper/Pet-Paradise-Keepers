<section class="profile" aria-label="Your account">
  <% if (user.profilePhoto) { %>
    <img src="<%= '/' + user.profilePhoto.replace(/^public\//, '').replace(/^\/+/, '') %>" alt="Profile picture of <%= user.firstName %>" class="profile-avatar">
  <% } else { %>
    <span class="profile-avatar" aria-hidden="true"><%= (user.firstName || '').slice(0, 1) %><%= (user.lastName || '').slice(0, 1) %></span>
  <% } %>
  <div class="profile-info">
    <h2><%= user.firstName %> <%= user.lastName %></h2>
    <span class="badge"><%= user.role === 'sitter' ? 'Pet sitter' : 'Pet parent' %></span>
  </div>
</section>
