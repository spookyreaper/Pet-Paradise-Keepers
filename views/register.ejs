<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Create an Account | Pet Paradise Keepers</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/ui.js" defer></script>
</head>
<body>
  <%- include('partials/header') %>

  <main class="auth-shell" id="main-content">
    <section class="auth-story" aria-labelledby="auth-story-title">
      <p class="eyebrow">EVERY PET HAS A STORY</p>
      <h2 id="auth-story-title">Keep the little things close.</h2>
      <p>Make a home for your pet's photos and care details, or introduce yourself as a pet sitter.</p>

      <ul class="auth-benefits">
        <li>
          <span class="icon-badge"><%- include('partials/icon', { name: 'paw' }) %></span>
          <div>
            <strong>Here for your pets</strong>
            <p>Create a profile for each pet and keep their medical history handy.</p>
          </div>
        </li>
        <li>
          <span class="icon-badge"><%- include('partials/icon', { name: 'heart' }) %></span>
          <div>
            <strong>Here to share your care</strong>
            <p>Build a sitter profile with your experience, biography, and rate.</p>
          </div>
        </li>
      </ul>

      <footer><small>A little organization for a whole lot of love.</small></footer>
    </section>

    <section class="auth-card" aria-labelledby="register-title">
      <p class="eyebrow">LET'S GET YOU SETTLED</p>
      <h1 id="register-title">Join the pet people.</h1>
      <p class="muted">Create your account, then make it your own.</p>

      <% if (errorMessage) { %>
        <div class="alert" id="register-error" role="alert"><%= errorMessage %></div>
      <% } %>

      <form class="auth-form" action="/register" method="post"<% if (errorMessage) { %> aria-describedby="register-error"<% } %>>
        <div class="form-grid">
          <div class="form-group">
            <label for="firstName">First name</label>
            <input type="text" id="firstName" name="firstName" required autocomplete="given-name" value="<%= typeof firstName !== 'undefined' ? firstName : '' %>" placeholder="First name">
          </div>
          <div class="form-group">
            <label for="lastName">Last name</label>
            <input type="text" id="lastName" name="lastName" required autocomplete="family-name" value="<%= typeof lastName !== 'undefined' ? lastName : '' %>" placeholder="Last name">
          </div>
        </div>

        <div class="form-group">
          <label for="username">Username</label>
          <input type="text" id="username" name="username" required pattern="[^@]+" title="Choose a username without an @ sign" autocomplete="username" aria-describedby="username-help" value="<%= typeof username !== 'undefined' ? username : '' %>" placeholder="Choose a username">
          <p class="field-help" id="username-help">Choose a username without an @ sign.</p>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required autocomplete="email" value="<%= typeof email !== 'undefined' ? email : '' %>" placeholder="you@example.com">
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <div class="password-field">
            <input type="password" id="password" name="password" required minlength="6" autocomplete="new-password" aria-describedby="password-help" placeholder="Create a password">
            <button type="button" id="togglePassword" class="password-toggle" data-password-toggle="password" aria-controls="password" aria-pressed="false" aria-label="Show password">Show</button>
          </div>
          <p class="field-help" id="password-help">Use at least 6 characters.</p>
        </div>

        <div class="form-group">
          <label for="role">I'm joining as a</label>
          <select id="role" name="role" required aria-describedby="role-help">
            <option value="owner" <%= role === 'owner' ? 'selected' : '' %>>Pet owner</option>
            <option value="sitter" <%= role === 'sitter' ? 'selected' : '' %>>Pet sitter</option>
          </select>
          <p class="field-help" id="role-help">Owners manage their pets. Sitters build their care profile.</p>
        </div>

        <button type="submit" class="button button-primary">Create account <%- include('partials/icon', { name: 'arrow-right' }) %></button>
      </form>

      <p class="auth-switch">Already part of the pack? <a href="/login">Log in</a></p>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
