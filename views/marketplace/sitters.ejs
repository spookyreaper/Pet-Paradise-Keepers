<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#244a3a">
  <title>Find pet sitters · Pet Paradise Keepers</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/ui.js" defer></script>
</head>
<body>
  <%- include('../partials/header') %>
  <%
    const photoUrl = value => {
      if (typeof value !== 'string') return '';
      const relative = value.replace(/^\/?public\//, '').replace(/^\/+/, '');
      return relative.startsWith('uploads/') ? '/' + relative : '';
    };
  %>
  <main class="page-shell" id="main-content">
    <div class="page-header">
      <div>
        <p class="eyebrow">Meet your pet people</p>
        <h1>Find a pet sitter</h1>
        <p class="muted">Get to know their experience, start a conversation, and request an interview.</p>
      </div>
      <a href="/jobs/new" class="button button-secondary"><%- include('../partials/icon', { name: 'plus' }) %> Post a sitting job</a>
    </div>

    <form action="/sitters" method="get" class="marketplace-filters form-card" aria-label="Search pet sitters">
      <div class="form-group">
        <label for="q">Search profiles</label>
        <input id="q" name="q" type="text" value="<%= filters.q || '' %>" placeholder="Name, experience, or pet care">
      </div>
      <div class="form-group">
        <label for="maxRate">Maximum hourly rate ($)</label>
        <input id="maxRate" name="maxRate" type="number" min="0" max="10000" step="0.01" value="<%= filters.maxRate ?? '' %>" placeholder="Any rate">
      </div>
      <div class="listing-actions">
        <button class="button button-primary" type="submit"><%- include('../partials/icon', { name: 'search' }) %> Search</button>
        <% if (filters.q || filters.maxRate !== '') { %><a href="/sitters" class="button button-ghost">Clear</a><% } %>
      </div>
    </form>

    <% if (errorMessage) { %><div class="alert" role="alert"><%= errorMessage %></div><% } %>

    <% if (sitters.length) { %>
      <div class="marketplace-grid">
        <% sitters.forEach(sitter => { const photo = photoUrl(sitter.profilePhoto); %>
          <article class="marketplace-card">
            <div class="marketplace-person">
              <% if (photo) { %>
                <img class="marketplace-avatar" src="<%= photo %>" alt="Profile photo of <%= sitter.firstName %>">
              <% } else { %>
                <span class="marketplace-avatar icon-badge" aria-hidden="true"><%= (sitter.firstName || '').slice(0, 1) %><%= (sitter.lastName || '').slice(0, 1) %></span>
              <% } %>
              <div>
                <span class="badge">Pet sitter</span>
                <h2><a href="/sitters/<%= sitter._id %>"><%= sitter.firstName %> <%= sitter.lastName %></a></h2>
              </div>
            </div>
            <p class="rate-tag">$<%= Number(sitter.rate || 0).toFixed(2) %><small>/hour</small></p>
            <p class="muted"><%= sitter.biography ? sitter.biography.slice(0, 180) + (sitter.biography.length > 180 ? '…' : '') : 'This sitter has not added a biography yet.' %></p>
            <% if (sitter.experience) { %><p class="field-help"><strong>Experience:</strong> <%= sitter.experience.slice(0, 140) %><%= sitter.experience.length > 140 ? '…' : '' %></p><% } %>
            <div class="listing-actions">
              <a href="/sitters/<%= sitter._id %>" class="button button-secondary button-small">View profile <%- include('../partials/icon', { name: 'arrow-right' }) %></a>
              <a href="/sitters/<%= sitter._id %>/request" class="text-link">Request an interview</a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } else { %>
      <section class="empty-state">
        <span class="icon-badge"><%- include('../partials/icon', { name: 'search' }) %></span>
        <h2>No sitters found yet.</h2>
        <p><%= filters.q || filters.maxRate !== '' ? 'Try a different search or remove the rate filter to see more profiles.' : 'Sitter profiles will appear here as pet sitters join.' %></p>
        <% if (filters.q || filters.maxRate !== '') { %><a href="/sitters" class="button button-secondary">View all sitters</a><% } %>
      </section>
    <% } %>

    <% if (typeof pagination !== 'undefined' && pagination.pages > 1) { %>
      <nav class="pagination" aria-label="Pet sitter pages">
        <% if (pagination.previous) { %><a class="button button-secondary button-small" href="<%= pagination.previous %>"><%- include('../partials/icon', { name: 'arrow-left' }) %> Previous</a><% } %>
        <span class="muted">Page <%= pagination.page %> of <%= pagination.pages %></span>
        <% if (pagination.next) { %><a class="button button-secondary button-small" href="<%= pagination.next %>">Next <%- include('../partials/icon', { name: 'arrow-right' }) %></a><% } %>
      </nav>
    <% } %>
  </main>
  <%- include('../partials/footer') %>
</body>
</html>
