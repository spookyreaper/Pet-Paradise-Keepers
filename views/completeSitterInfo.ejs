<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#244a3a">
  <title>Create your sitter profile · Pet Paradise Keepers</title>
  <link rel="stylesheet" href="/css/styles.css">
  <script src="/js/ui.js" defer></script>
</head>
<body>
  <%- include('partials/header') %>
  <main id="main-content" class="page-shell page-shell-narrow">
    <div class="page-header">
      <div><p class="eyebrow">Welcome, pet person</p><h1>Great care starts with you.</h1><p class="muted">Introduce yourself, share your experience, and make this space yours.</p></div>
    </div>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
      <div class="alert" role="alert"><%= errorMessage %></div>
    <% } %>
    <form class="form-card" action="/sitter/complete-info" method="post" enctype="multipart/form-data">
      <section class="form-section" aria-labelledby="aboutHeading">
        <div class="section-heading"><div><p class="eyebrow">Your approach to care</p><h2 id="aboutHeading">A little about you</h2></div><%- include('partials/icon', { name: 'heart' }) %></div>
        <div class="form-group">
          <label for="biography">About you</label>
          <textarea id="biography" name="biography" rows="4" required aria-describedby="biographyHelp" placeholder="Tell us about yourself and the care you bring"><%= user.biography || '' %></textarea>
          <p id="biographyHelp" class="field-help">Share your approach to looking after pets.</p>
        </div>
        <div class="form-group">
          <label for="experience">Pet care experience</label>
          <textarea id="experience" name="experience" rows="4" required aria-describedby="experienceHelp" placeholder="Animals you've cared for, training, and skills"><%= user.experience || '' %></textarea>
          <p id="experienceHelp" class="field-help">Every bit of relevant experience helps tell your story.</p>
        </div>
        <div class="form-grid">
          <div class="form-group">
            <label for="rate">Hourly rate ($)</label>
            <input type="number" id="rate" name="rate" value="<%= user.rate ?? 0 %>" min="0" step="0.01" required aria-describedby="rateHelp">
            <p id="rateHelp" class="field-help">Your rate per hour of care.</p>
          </div>
        </div>
      </section>
      <section class="form-section" aria-labelledby="photoHeading">
        <div class="section-heading"><div><p class="eyebrow">A friendly face</p><h2 id="photoHeading">Profile photo</h2></div><span class="badge">Optional</span></div>
        <div class="upload-field">
          <div class="photo-preview">
            <% if (user.profilePhoto) { %>
              <img src="<%= '/' + user.profilePhoto.replace(/^public\//, '').replace(/^\/+/, '') %>" alt="Your current profile photo" id="onboarding-sitter-photo" data-image-preview>
            <% } else { %>
              <img alt="Your selected profile photo" id="onboarding-sitter-photo" data-image-preview hidden>
              <span class="photo-placeholder" aria-hidden="true"><%- include('partials/icon', { name: 'user' }) %></span>
            <% } %>
          </div>
          <div class="form-group">
            <label for="profilePhoto">Profile photo</label>
            <input type="file" id="profilePhoto" name="profilePhoto" accept="image/jpeg,image/png,image/gif,image/webp" data-image-input="onboarding-sitter-photo" aria-describedby="profilePhotoHelp">
            <p id="profilePhotoHelp" class="field-help">JPG, PNG, GIF, or WebP. Up to 5 MB.</p>
          </div>
        </div>
      </section>
      <div class="form-actions">
        <a href="/dashboard" class="button button-ghost">Skip for now</a>
        <button type="submit" class="button button-primary">Save my profile <%- include('partials/icon', { name: 'arrow-right' }) %></button>
      </div>
    </form>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
